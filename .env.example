TZ=Asia/Shanghai
VNC_GEOMETRY=1440x900
VNC_DEPTH=24

HILLSTONE_IMAGE=hillstonenet-hillstone-vpn:bookworm
HILLSTONE_CONTAINER_NAME=hillstone-vpn
VPN_DOCKER_SUBNET=172.30.50.0/24
VPN_CONTAINER_IP=172.30.50.2

# Bind explicitly to the Docker host's LAN address. Do not use 0.0.0.0 on an Internet-facing host.
# Direct noVNC HTTP access. Use only on a trusted LAN; HTTPS remains available below.
NOVNC_HTTP_BIND_IP=192.168.1.10
NOVNC_HTTP_PORT=6080
NOVNC_HTTPS_BIND_IP=192.168.1.10
NOVNC_HTTPS_PORT=8443
SOCKS_BIND_IP=192.168.1.10
SOCKS_PORT=1080

# No SOCKS authentication is enabled. Restrict source networks here.
SOCKS_ALLOWED_CIDRS=192.168.1.0/24

HILLSTONE_SERVICE_COMMAND=/opt/apps/hillstonesecureconnect/files/bin/HillstoneSecureConnectService
HILLSTONE_GUI_COMMAND=/opt/apps/hillstonesecureconnect/files/bin/HillstoneSecureConnect.sh
# Keep the main window visible after VPN connects. Set true to restore vendor auto-minimize behavior.
HILLSTONE_AUTO_MINIMIZE=false

# Tighten after observing the actual VPN interface.
VPN_TUN_REGEX=^(tun|tap|ppp|hsc|sc)[0-9_-]*$
# Optional enterprise host/IP reachable only through the VPN.
VPN_PROBE_HOST=
ENABLE_IPV6=false
