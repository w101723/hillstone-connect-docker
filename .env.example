TZ=Asia/Shanghai
VNC_GEOMETRY=1440x900
VNC_DEPTH=24

HILLSTONE_IMAGE=ghcr.io/w101723/hillstone-connect:latest
HILLSTONE_CONTAINER_NAME=hillstone-vpn
VPN_DOCKER_SUBNET=172.30.50.0/24
VPN_CONTAINER_IP=172.30.50.2

# Bind explicitly to the Docker host's trusted LAN address. Do not expose noVNC or SOCKS to the Internet.
NOVNC_HTTP_BIND_IP=192.168.1.10
NOVNC_HTTP_PORT=6080
SOCKS_BIND_IP=192.168.1.10
SOCKS_PORT=1080

HILLSTONE_SERVICE_COMMAND=/opt/apps/hillstonesecureconnect/files/bin/HillstoneSecureConnectService
HILLSTONE_GUI_COMMAND=/opt/apps/hillstonesecureconnect/files/bin/HillstoneSecureConnect.sh
# Keep the main window visible after VPN connects. Set true to restore vendor auto-minimize behavior.
HILLSTONE_AUTO_MINIMIZE=false
